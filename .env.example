# ==============================================================================
# Slap Biometrics Studio Environment Configuration
# ==============================================================================

STUDIO_PORT=8001
DEVICE_MODE=auto

# ==============================================================================
# MongoDB Credentials & Connection URI
# (Paste your MongoDB Atlas, remote server, or local MongoDB credentials below)
# ==============================================================================
MONGODB_USERNAME="your_username"
MONGODB_PASSWORD="your_password"
MONGODB_URI="mongodb+srv://your_username:your_password@cluster0.example.mongodb.net"

# Optional API workstation token (leave blank for unrestricted localhost access)
API_TOKEN=""
